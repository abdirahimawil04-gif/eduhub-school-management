rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Multi-Branch Data Model (from SPEC.md)
    // ===============================================================
    // Collection: organizations
    // Collection: branches (belongs to organization)
    // Collection: users (belongs to branch, role-based)
    // Collection: students, teachers, classes, subjects
    // Collection: exams, examResults, attendance
    // Collection: feeStructures, invoices, payments
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'super_admin' || 
         (request.auth.token.email in ["rammadan1213@gmail.com", "abdirahimawil04@gmail.com"] && request.auth.token.email_verified == true));
    }

    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (getUserData().role == 'school_admin' && getUserData().schoolId == schoolId);
    }

    function isTeacher(schoolId) {
      return isAuthenticated() && (getUserData().role == 'teacher' && getUserData().schoolId == schoolId);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.role in ['super_admin', 'school_admin', 'teacher', 'accountant', 'student'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isSuperAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isSuperAdmin());
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /teachers/{teacherId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId) || isTeacher(request.resource.data.schoolId));
    }

    match /fees/{feeId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId) || getUserData().role == 'accountant');
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId || resource.data.targetRole == 'all' || resource.data.targetRole == getUserData().role);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /examResults/{resultId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId) || isTeacher(request.resource.data.schoolId));
    }

    match /feeStructures/{feeStructureId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId));
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId || resource.data.studentId == getUserData().studentId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId) || getUserData().role == 'accountant');
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || getUserData().schoolId == resource.data.schoolId);
      allow write: if isAuthenticated() && (isSuperAdmin() || isSchoolAdmin(request.resource.data.schoolId) || getUserData().role == 'accountant');
    }
  }
}
